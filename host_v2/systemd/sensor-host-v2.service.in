[Unit]
Description=Sensor System host v2 recorder
Documentation=file://@REPOSITORY_ROOT@/host_v2/DEPLOY-RASPBERRY-PI.md
After=local-fs.target time-sync.target
Wants=time-sync.target
RequiresMountsFor=@RUNTIME_DATA_ROOT@
StartLimitIntervalSec=300
StartLimitBurst=4

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
SupplementaryGroups=dialout
WorkingDirectory=@REPOSITORY_ROOT@
ExecStartPre=@CURRENT_BINARY@ validate --config @CONFIG_PATH@ --repository-root @REPOSITORY_ROOT@
ExecStart=@CURRENT_BINARY@ run --config @CONFIG_PATH@ --repository-root @REPOSITORY_ROOT@ --status-file /run/sensor-system/host-v2-status.json
Restart=on-failure
RestartSec=15s
# Permanent environment/configuration/storage failures need operator action.
# EX_UNAVAILABLE=69, EX_CANTCREAT=73 and EX_CONFIG=78.
RestartPreventExitStatus=2 69 73 78
TimeoutStartSec=120s
TimeoutStopSec=120s
KillSignal=SIGTERM
KillMode=control-group
RuntimeDirectory=sensor-system
RuntimeDirectoryMode=0750
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sensor-host-v2
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=@RUNTIME_DATA_ROOT@

[Install]
WantedBy=multi-user.target
