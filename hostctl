#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST_BINARY="${SENSOR_HOST_BINARY:-$ROOT_DIR/host_v2/target/release/sensor-host}"
DOCTOR_BINARY="${SENSOR_HOST_DOCTOR_BINARY:-$ROOT_DIR/host_v2/target/release/sensor-doctor}"
HIL_BINARY="${SENSOR_HOST_HIL_BINARY:-$ROOT_DIR/host_v2/target/release/sensor-hil}"
CAPTURE_VALIDATE_BINARY="${SENSOR_CAPTURE_VALIDATE_BINARY:-$ROOT_DIR/host_v2/target/release/capture-validate}"
CAPTURE_EXPORT_BINARY="${SENSOR_CAPTURE_EXPORT_BINARY:-$ROOT_DIR/host_v2/target/release/capture-export}"
OPERATIONS_BINARY="${SENSOR_OPERATIONS_BINARY:-$ROOT_DIR/host_v2/target/release/sensor-operations}"
HOST_CONFIG="${SENSOR_HOST_CONFIG:-$ROOT_DIR/host/system_config.json}"
STATUS_FILE="${SENSOR_HOST_STATUS_FILE:-/run/sensor-system/host-v2-status.json}"
OPERATIONS_SOCKET="${SENSOR_HOST_OPERATIONS_SOCKET:-/run/sensor-system/operations-v1.sock}"

cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
Usage:
  ./hostctl <command> [args...]

Host v2:
  build                 Build all native host v2 release binaries
  validate              Validate the effective v2 installation profile
  discover              Read-only discovery of every enabled node
  run                   Run the v2 recorder in the foreground
  paths [--init]        Show or create effective v2 storage paths
  doctor                Check configuration, runtime and optionally RS485
  channel status|maintenance|resume --channel ID
  channel get-configuration --channel ID --node ID
  channel validate-configuration --channel ID --node ID [configuration options]
  channel apply-configuration --channel ID --node ID --expected-revision N [configuration options]
  channel reset-configuration --channel ID --node ID --expected-revision N
  channel restart-node --channel ID --node ID
  channel scan-unassigned --channel ID --round-nonce N --slot-count N
  channel assign-address --channel ID --round-nonce N --hardware-id HEX --new-node-address ID
                         Control a running channel through local Operations IPC

Data:
  capture validate ROOT                 Validate all sealed Capture streams
  capture export CAPTURE_DIR OUTPUT_DIR Validate and export one stream to CSV

Node service (protocol 5 over RS485):
  node <sensor-hil command> [args...]    Identity, diagnostics, time and recovery
  update [options]                      Fail-closed application + A/B update

Service:
  install-services      Install a checksummed v2 systemd release
  rollback-services     Switch to the previous v2 systemd release
  start|stop|restart    Control sensor-host-v2.service
  status|logs           Inspect sensor-host-v2.service

Defaults:
  config: host/system_config.json
  status: /run/sensor-system/host-v2-status.json
  operations: /run/sensor-system/operations-v1.sock

Examples:
  ./hostctl validate
  ./hostctl discover
  ./hostctl run
  ./hostctl doctor --deep
  ./hostctl capture validate var/recordings
  ./hostctl node diagnostics /dev/sensor-system-line-b 1 HARDWARE_ID 2 115200
  ./hostctl update --port /dev/sensor-system-line-b --node 1 \
    --hardware-id HARDWARE_ID --board-revision 2 --expected-firmware 0.5.7
EOF
}

missing_binary() {
  echo "[ERROR] missing host v2 binary: $1" >&2
  echo "Build it with: ./hostctl build" >&2
  exit 69
}

require_binary() {
  [[ -x $1 ]] || missing_binary "$1"
}

if (($# == 0)); then
  usage
  exit 64
fi

COMMAND="$1"
shift

HAS_CONFIG=0
HAS_REPOSITORY=0
HAS_STATUS=0
HAS_OPERATIONS_SOCKET=0
for argument in "$@"; do
  [[ $argument == --config ]] && HAS_CONFIG=1
  [[ $argument == --repository-root ]] && HAS_REPOSITORY=1
  [[ $argument == --status-file ]] && HAS_STATUS=1
  [[ $argument == --operations-socket ]] && HAS_OPERATIONS_SOCKET=1
done

case "$COMMAND" in
  help|-h|--help)
    usage
    ;;
  build)
    exec cargo build --release --workspace --manifest-path "$ROOT_DIR/host_v2/Cargo.toml" "$@"
    ;;
  validate|discover)
    require_binary "$HOST_BINARY"
    EXECUTION=("$HOST_BINARY" "$COMMAND")
    ((HAS_CONFIG)) || EXECUTION+=(--config "$HOST_CONFIG")
    ((HAS_REPOSITORY)) || EXECUTION+=(--repository-root "$ROOT_DIR")
    exec "${EXECUTION[@]}" "$@"
    ;;
  run)
    require_binary "$HOST_BINARY"
    EXECUTION=("$HOST_BINARY" run)
    ((HAS_CONFIG)) || EXECUTION+=(--config "$HOST_CONFIG")
    ((HAS_REPOSITORY)) || EXECUTION+=(--repository-root "$ROOT_DIR")
    ((HAS_STATUS)) || EXECUTION+=(--status-file "$STATUS_FILE")
    ((HAS_OPERATIONS_SOCKET)) || EXECUTION+=(--operations-socket "$OPERATIONS_SOCKET")
    exec "${EXECUTION[@]}" "$@"
    ;;
  channel)
    require_binary "$OPERATIONS_BINARY"
    exec "$OPERATIONS_BINARY" "$@" --socket "$OPERATIONS_SOCKET"
    ;;
  paths)
    require_binary "$HOST_BINARY"
    EXECUTION=("$HOST_BINARY" paths)
    ((HAS_CONFIG)) || EXECUTION+=(--config "$HOST_CONFIG")
    ((HAS_REPOSITORY)) || EXECUTION+=(--repository-root "$ROOT_DIR")
    exec "${EXECUTION[@]}" "$@"
    ;;
  doctor)
    require_binary "$DOCTOR_BINARY"
    EXECUTION=("$DOCTOR_BINARY")
    ((HAS_CONFIG)) || EXECUTION+=(--config "$HOST_CONFIG")
    ((HAS_REPOSITORY)) || EXECUTION+=(--repository-root "$ROOT_DIR")
    ((HAS_STATUS)) || EXECUTION+=(--status-file "$STATUS_FILE")
    exec "${EXECUTION[@]}" "$@"
    ;;
  capture)
    SUBCOMMAND="${1:-}"
    [[ -n $SUBCOMMAND ]] || { echo "[ERROR] capture requires validate or export" >&2; exit 64; }
    shift
    case "$SUBCOMMAND" in
      validate)
        require_binary "$CAPTURE_VALIDATE_BINARY"
        exec "$CAPTURE_VALIDATE_BINARY" "$@"
        ;;
      export)
        require_binary "$CAPTURE_EXPORT_BINARY"
        exec "$CAPTURE_EXPORT_BINARY" "$@"
        ;;
      *)
        echo "[ERROR] unknown capture command: $SUBCOMMAND" >&2
        exit 64
        ;;
    esac
    ;;
  node)
    require_binary "$HIL_BINARY"
    [[ $# -gt 0 ]] || { "$HIL_BINARY" --help; exit 64; }
    exec "$HIL_BINARY" "$@"
    ;;
  update)
    exec "$ROOT_DIR/host_v2/tools/update_node_v2.sh" "$@"
    ;;
  install-services)
    if [[ ${SENSOR_HOST_SKIP_BUILD:-0} != 1 ]]; then
      cargo build --release -p sensor-host --manifest-path "$ROOT_DIR/host_v2/Cargo.toml"
    fi
    require_binary "$HOST_BINARY"
    "$HOST_BINARY" validate --config "$HOST_CONFIG" --repository-root "$ROOT_DIR"
    exec "$ROOT_DIR/host_v2/tools/install_systemd_service.sh" \
      --repository-root "$ROOT_DIR" --config "$HOST_CONFIG" --binary "$HOST_BINARY" \
      --user "${SENSOR_HOST_SERVICE_USER:-$(id -un)}" \
      --group "${SENSOR_HOST_SERVICE_GROUP:-$(id -gn)}" "$@"
    ;;
  rollback-services)
    exec "$ROOT_DIR/host_v2/tools/rollback_systemd_service.sh" "$@"
    ;;
  start|stop|restart|status|logs)
    exec "$ROOT_DIR/host_v2/tools/service_control.sh" "$COMMAND" "$@"
    ;;
  ping|config|lab|recorder|archive|verify|supervisor|console|dashboard|operator|boot|py)
    echo "[ERROR] '$COMMAND' belongs to the retired Python host and is not exposed by hostctl v2" >&2
    echo "See docs/legacy/ for historical procedures." >&2
    exit 64
    ;;
  *)
    echo "[ERROR] unknown command: $COMMAND" >&2
    usage >&2
    exit 64
    ;;
esac
