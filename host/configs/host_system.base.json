{
  "system": {
    "name": "sensor-system",
    "timezone": "Europe/Warsaw"
  },
  "storage": {
    "root_dir": "var/recordings",
    "archive_dir": "var/archive",
    "format": "hdf5",
    "compression": "gzip",
    "window_seconds": 600,
    "capture_schema": 1
  },
  "supervisor": {
    "status_file": "/run/sensor-system/supervisor.status.json",
