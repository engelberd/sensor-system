{
  "extends": "configs/systems/rpi-sanok.json",
  "system": {
    "name": "macos-workstation",
    "site": "local-development"
  },
  "storage": {
    "root_dir": "var/recordings",
    "archive_dir": "var/archive",
    "capture_v2": {"checkpoint_dir": "var/recordings/.retention"},
