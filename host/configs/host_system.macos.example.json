    {"name": "line-b", "enabled": false, "transport": {"endpoint": "/dev/cu.REPLACE-line-b"}},
    {"name": "line-c", "enabled": false, "transport": {"endpoint": "/dev/cu.REPLACE-line-c"}},
    {"name": "line-d", "enabled": false, "transport": {"endpoint": "/dev/cu.REPLACE-line-d"}},
    {"name": "line-g", "enabled": false, "transport": {"endpoint": "/dev/cu.REPLACE-line-g"}},
    {"name": "line-h", "enabled": false, "transport": {"endpoint": "/dev/cu.REPLACE-line-h"}}
  ]
}
