{
  "system": {
    "name": "sensor-system",
    "timezone": "Europe/Warsaw"
  },
  "storage": {
    "root_dir": "var/recordings",
    "archive_dir": "var/archive",
    "format": "hdf5",
    "compression": "gzip",
    "window_seconds": 600,
    "capture_schema": 1,
    "min_free_bytes": 1073741824,
    "capture_v2": {
      "checkpoint_dir": "var/recordings/.retention",
      "queue_capacity_records": 64,
      "group_commit_max_records": 8,
      "group_commit_max_wait_ms": 5,
      "worker_prefix": "capture",
      "capture_grace_seconds": 172800,
      "archive_retention_seconds": 2592000
    },
    "time_v2": {
      "root_dir": "var/recordings/time",
      "queue_capacity_records": 64,
      "worker_name": "time-storage",
      "sync_interval_ms": 10000,
      "sync_estimated_slot_ms": 20,
      "sync_retry_delay_ms": 250
    },
    "analysis_v2": {
      "enabled": true,
      "root_dir": "var/analysis",
      "scan_interval_seconds": 60
    }
  },
  "runtime_v2": {
    "supervision_interval_ms": 100,
    "metrics_interval_ms": 10000,
    "transaction_timeout_ms": 250,
    "retry_delay_ms": 25,
    "measurement_attempts_per_slot": 2,
    "max_pending_work_items": 8,
    "quarantine_us": 50000,
    "bootstrap_node_deadline_ms": 5000,
    "serial_io_timeout_ms": 10,
    "maximum_utilization_ppm": 900000,
    "recovery_reserve_ppm": 100000,
    "target_chunk_samples": 32,
    "measurement_transaction_time_us": 36900,
    "measurement_slot_us": 40000,
    "maximum_service_interval_ms": 500,
    "retry_base_delay_ms": 10,
    "retry_max_delay_ms": 1000,
    "retry_attempt_limit": 3,
    "offline_probe_interval_ms": 5000,
    "time_sync_transaction_time_ms": 4,
    "overflow_guard_ms": 100,
    "max_slot_ms": 50,
    "first_time_sync_delay_ms": 1000,
    "time_sync_phase_step_ms": 100,
    "activation_node_deadline_ms": 5000,
    "shutdown_barrier_deadline_ms": 2000,
    "shutdown_node_deadline_ms": 5000,
    "shutdown_drain_deadline_ms": 5000,
    "operations_mailbox_capacity": 8,
    "operations_ledger_capacity": 64,
    "maintenance_barrier_deadline_ms": 2000,
    "maintenance_drain_deadline_ms": 5000,
    "service_operation_deadline_ms": 5000,
    "safe_orderly_attempts": 2,
    "safe_restart_attempts": 2,
    "safe_restart_cycles": 1,
    "safe_action_deadline_ms": 1000,
    "safe_restart_settle_ms": 500,
    "safe_restart_confirmation_ms": 5000,
    "resume_node_deadline_ms": 5000
  },
  "supervisor": {
    "status_file": "/run/sensor-system/supervisor.status.json",
    "event_log": "var/log/supervisor.events.jsonl",
    "channel_runtime_dir": "/run/sensor-system",
    "log_dir": "var/log",
    "status_interval_s": 1.0,
    "restart_delay_s": 2.0,
    "restart_delay_max_s": 60.0,
    "process_log_max_bytes": 10485760,
    "process_log_backup_count": 3,
    "console_status_interval_s": 30.0
  }
}
