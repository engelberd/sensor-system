[Unit]
Description=ADXL355 read-only dashboard
After=network-online.target adxl355-supervisor.service
Wants=network-online.target
PartOf=adxl355-supervisor.service

[Service]
Type=simple

# Adjust this to where you deploy the repo (or a copy of it).
WorkingDirectory=/opt/sensor-system

# Optional environment file for overriding dashboard settings without editing the unit.
# Create e.g. /etc/adxl355-dashboard.env and set:
#   ADXL355_CONFIG=/opt/sensor-system/host/system_config.json
#   ADXL355_DASHBOARD_HOST=0.0.0.0
#   ADXL355_DASHBOARD_PORT=8090
EnvironmentFile=-/etc/adxl355-dashboard.env

Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/sensor-system/host/.venv/bin/python /opt/sensor-system/host/host_dashboard.py \
  --config ${ADXL355_CONFIG:-/opt/sensor-system/host/system_config.json} \
  --host ${ADXL355_DASHBOARD_HOST:-0.0.0.0} \
  --port ${ADXL355_DASHBOARD_PORT:-8090}

Restart=always
RestartSec=5

TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
