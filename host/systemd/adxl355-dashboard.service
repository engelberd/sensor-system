[Unit]
Description=ADXL355 read-only dashboard
After=network-online.target adxl355-supervisor.service
Wants=network-online.target
PartOf=adxl355-supervisor.service

[Service]
Type=simple
User=anone
Group=anone
WorkingDirectory=/home/anone/pico-projects
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/anone/pico-projects/host/.venv/bin/python /home/anone/pico-projects/host/host_dashboard.py --config /home/anone/pico-projects/host/system_config.json --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
