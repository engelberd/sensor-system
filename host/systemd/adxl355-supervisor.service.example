[Unit]
Description=ADXL355 RS485 multi-channel supervisor
After=network-online.target
Wants=network-online.target adxl355-dashboard.service

[Service]
Type=simple

# Adjust this to where you deploy the repo (or a copy of it).
WorkingDirectory=/opt/sensor-system

# Optional environment file for overriding the config path without editing the unit.
# Create e.g. /etc/adxl355-supervisor.env and set:
#   ADXL355_CONFIG=/opt/sensor-system/host/system_config.json
Environment=ADXL355_CONFIG=/opt/sensor-system/host/system_config.json
EnvironmentFile=-/etc/adxl355-supervisor.env

Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=sensor-system
RuntimeDirectoryMode=0755
UMask=0027

ExecStart=/opt/sensor-system/host/.venv/bin/python /opt/sensor-system/host/host_supervisor.py \
  --config ${ADXL355_CONFIG}

Restart=always
RestartSec=5

TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
